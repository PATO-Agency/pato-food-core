# Local internal demo only. Copy relevant values into apps/web/.env.local.
# No real customer resources are required for the fixture-backed demo.
PATO_CONTENT_SOURCE=fixture
PATO_SITE_VISIBILITY=internal
# Required only for a future public release. Must be the approved HTTPS origin.
PATO_SITE_URL=
# Set only when an upstream access-control layer protects a hosted internal preview.
PATO_HOSTED_INTERNAL_PREVIEW=
# Exact trusted parent allowed to embed the Preview in Sanity Presentation.
# Use HTTPS when hosted; loopback HTTP is accepted only for local development.
PATO_STUDIO_ORIGIN=http://localhost:3333
# Optional for an explicit `next start` smoke test bound to loopback; never host it.
PATO_LOCAL_INTERNAL=
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=
# Local migration/seed use only. Never expose this variable to the browser or deployment.
SANITY_WRITE_TOKEN=
# Dedicated least-privilege server token used only for durable webhook receipts.
SANITY_REVALIDATION_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=
# Required for a hosted internal preview: pin deliveries to the configured webhook.
SANITY_WEBHOOK_ID=
# Analytics stays disabled until a consent policy and test property are approved.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# For apps/studio/.env.local only, using a PATO-controlled test project.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Full preview URL used only by the local/protected Studio. A hosted value must
# use HTTPS. Keep any protection-bypass query secret in an ignored local env.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
