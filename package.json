{
  "name": "pato-food-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@pato-food/web",
    "dev:studio": "npm run dev --workspace=@pato-food/studio",
    "build": "npm run build --workspace=@pato-food/studio && npm run build --workspace=@pato-food/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages examples tooling vitest.config.ts",
    "format": "prettier --write apps packages examples tooling .github package.json tsconfig.base.json vitest.config.ts eslint.config.mjs README.md",
    "format:check": "prettier --check apps packages examples tooling .github package.json tsconfig.base.json vitest.config.ts eslint.config.mjs README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:vicafoods:sandbox": "tsx --env-file=apps/web/.env.local tooling/seed-vicafoods-sandbox.ts",
    "verify:editorial:synthetic": "node --experimental-strip-types --env-file=apps/web/.env.local tooling/verify-synthetic-editorial-flow.ts",
    "prune:revalidation-receipts": "node --experimental-strip-types --env-file=apps/web/.env.local tooling/prune-revalidation-receipts.ts",
    "check:secrets": "node tooling/check-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:secrets && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.1"
  }
}
